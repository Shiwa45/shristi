DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Postgres (omit to use SQLite for first run)
# POSTGRES_DB=partyvoice
# POSTGRES_USER=partyvoice
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=127.0.0.1
# Redis (omit to use in-memory channel layer for first run)
# REDIS_URL=redis://127.0.0.1:6379/0
# ZEGOCLOUD (server-side only)
ZEGO_APP_ID=0
ZEGO_SERVER_SECRET=
ZEGO_TOKEN_TTL_SECONDS=7200
